# ---- LLM configuration ---------------------------------------------------
# LLM_MODE controls how agent "thinking" is produced:
#   live   -> real API calls (needs a valid key below)
#   replay -> reuse cached agent outputs from a prior successful run (deterministic)
#   mock   -> canned outputs; runs fully offline with NO key (safe demo default)
LLM_MODE=mock

LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-3-5-sonnet-latest
LLM_API_KEY=

# ---- Governance ----------------------------------------------------------
# How human approvals are surfaced:
#   dashboard -> approve/reject in the web UI (source of truth is still the file)
#   file      -> edit the approval JSON, then `orchestrator resume`
#   cli       -> interactive blocking prompt in the terminal
APPROVAL_MODE=dashboard

# Autonomy boundary: node impact levels that REQUIRE a human gate.
REQUIRE_APPROVAL_FOR=schema_change,release,merge,ambiguity,policy_violation

# ---- GitHub publication (dashboard Implement action) ----------------------
# Fine-grained token for this repository with Contents: write and
# Pull requests: write. The token is never persisted in run artifacts.
GITHUB_TOKEN=

# Native runs discover the repository from the current directory. Override
# when the dashboard starts elsewhere; Docker Compose sets /source-repo.
SOURCE_REPO_PATH=.
# `origin` is preferred automatically; a sole non-origin remote is also used.
GIT_REMOTE_NAME=
GIT_BASE_BRANCH=
GIT_AUTHOR_NAME=Agentic SDLC
GIT_AUTHOR_EMAIL=agentic-sdlc@users.noreply.github.com
IMPLEMENT_WORKERS=2

# ---- Persistence ---------------------------------------------------------
# URL-shortener data remains separate from Governance requirements.
DB_URL=sqlite:///target-app/urls.db
# Governance uses WORKSPACE_DIR/governance.db plus WORKSPACE_DIR/runs/.
WORKSPACE_DIR=workspace

# ---- Reliability controls ------------------------------------------------
MAX_RETRIES=2                   # bounded retries per node before fallback/stop
RETRY_BACKOFF_SECONDS=1
